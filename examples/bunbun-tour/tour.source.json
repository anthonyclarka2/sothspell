        },
        {
          "id": "beat_purpose_03",
          "title": "One glossary, shared by everyone",
          "narration": "The domain language is explicit. Account, User, Bun, Thread, Comment, and Reply each mean one thing. A bun is a discussion group represented by an ATProto identity, a thread belongs to one bun, and replies nest inside a thread. The glossary is required reading before changing domain code.",
          "durationMs": 34000,
          "anchors": [
