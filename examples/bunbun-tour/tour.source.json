      "beats": [
        {
          "id": "beat_write_01",
          "title": "Identity comes from proof, not from input",
          "narration": "Writes begin with identity. OAuthSessionGuard restores the persisted OAuth session, resolves the author, and attaches that author to the request. Downstream code never accepts an author from the request body, which is the difference between an authenticated write and a hopeful one.",
          "durationMs": 38000,
          "anchors": [
            {
              "id": "anchor_oauth_guard",
              "path": "apps/api/src/atproto/oauth-session.guard.ts",
