          ],
          "stage": {
            "anchorIds": ["anchor_oauth_guard"],
            "diagramId": "diagram_write_path",
            "nodeIds": ["node_guard", "node_service"],
            "edgeIds": ["edge_guard_service"]
          }
        },
        {
          "id": "beat_write_02",
          "title": "The service orders the write",
          "narration": "CommentsService.create validates the text, thread, and parent, computes the root, calls the PDS adapter, then upserts the local index. The author came from the guard; the service does not re-derive it from the payload. The order matters: the record exists before the index claims it does.",
          "durationMs": 40000,
          "anchors": [
            {
              "id": "anchor_comments_create",
              "path": "apps/api/src/comments/comments.service.ts",
