# Sóþspell local configuration. Copy to .env and fill in only what you need.

# Where snapshots, tours, runs, audio, and caches live.
SOTHSPELL_HOME=~/.sothspell

# The project the local API reads full source from. It is never written to.
SOTHSPELL_PROJECT_ROOT=/path/to/your/project

# Authoring and in-tour questions. Use <provider>/<model>.
# SOTHSPELL_MODEL=openai/gpt-5.2
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional cloud narration. Browser speech is the default.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Local server.
PORT=4319
HOST=127.0.0.1
